{
  "name": "romaja",
  "compatibility_date": "2026-08-25",
  // 靜態網站之外只有一支 Worker：處理 /api/feedback，把回饋寄給站長
  "main": "worker/index.js",
  "assets": {
    "directory": "dist",
    "binding": "ASSETS"
  },
  // 寄信用 Cloudflare Email Routing，只准寄到 contact@latype.com
  "send_email": [{ "name": "FEEDBACK_MAIL", "destination_address": "contact@latype.com" }],
  "vars": {
    "FEEDBACK_FROM": "feedback@latype.com",
    "FEEDBACK_TO": "contact@latype.com"
  }
}
